
.env
.env.local
node_modules/

# ─── Compiled build artifacts — never commit build output ───
# A 51 MB engine.exe was committed here once and had to be purged from git
# history in a coordinated rewrite (Milestone 0.2). Build output belongs in
# CI artifacts or a container registry, never in git.
# Enforced structurally by .github/workflows/file-size-guard.yml.
*.exe
*.dll
*.so
*.dylib
*.test

# `go build ./cmd/engine` drops the binary at the repo root. Anchored with a
# leading slash so it CANNOT match the cmd/engine/ SOURCE directory.
/engine

# Coverage profiles are build output, regenerated by CI and by
# scripts/check-coverage.sh. Never committed.
coverage.out
*.coverprofile

# Gate A artifacts: the Monte-Carlo report and the logs its CI guards parse.
# The report is a per-run measurement, uploaded as a CI artifact, never committed.
rtp-report.json
rtp.log
rtp-short.log

# Gate B artifacts: the GC/SC identity report and the logs its CI guard parses.
currency-identity-report.json
identity.log
identity-structure.log
identity-crosscheck.log

# Integration test logs captured by the CI skip-guard — one per suite, since
# cmd/engine and internal/repository run against separate databases.
engine.log
repo.log
